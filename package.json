{
  "name": "cardwake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cardwake — programmable card stacks in natural language, where each card can host an AI agent bounded by its level.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=basic",
    "test:props": "CARDWAKE_PROP_RUNS=2000 vitest run --dir packages",
    "build": "npm run build --workspace @cardwake/web",
    "preview": "npm run preview --workspace @cardwake/web",
    "guards": "python3 scripts/guards/run_all.py",
    "limits": "python3 scripts/guards/check_limits.py",
    "ci": "npm run typecheck && npm run test:ci && npm run guards",
    "preuves": "CARDWAKE_PREUVES=1 vite-node packages/proofs/cli.ts",
    "preuves:rapport": "CARDWAKE_PREUVES=1 vite-node packages/proofs/cli.ts --rapport"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "^4.14.0",
    "fast-check": "^3.23.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
